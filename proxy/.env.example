# ─────────────────────────────────────────────────────────────────────
# csd-proxy — Environment Variables
# ─────────────────────────────────────────────────────────────────────

# Static X25519 private key for the proxy (REQUIRED).
# Generate with: node src/generate-keypair.js
PROXY_PRIVATE_KEY=your_64_hex_char_private_key_here

# WebSocket listen port (default: 8443).
# WS_PORT=8443

# WebSocket bind address (default: 0.0.0.0).
# WS_HOST=0.0.0.0

# TCP backend host (default: csd-us-east.lproute.com).
# TCP_TARGET_HOST=csd-us-east.lproute.com

# TCP backend port (default: 8760).
# TCP_TARGET_PORT=8760